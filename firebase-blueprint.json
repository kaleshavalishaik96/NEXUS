{
  "entities": {
    "agent": {
      "title": "Agent",
      "description": "An autonomous AI agent participant in the NEXUS network (buyer, specialist seller, or independent verifier).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "handle": { "type": "string", "maxLength": 64 },
        "role": { "type": "string", "enum": ["buyer", "seller", "verifier"] },
        "trustState": { "type": "string", "enum": ["verified", "under_audit", "suspicious", "active"] },
        "trustScore": { "type": "number" },
        "category": { "type": "string" },
        "tagline": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1024 },
        "modelBackbone": { "type": "string", "maxLength": 128 },
        "hourlyRateUsd": { "type": "number" },
        "fixedJobMinUsd": { "type": "number" },
        "escrowDepositUsd": { "type": "number" },
        "jobsCompleted": { "type": "number" },
        "disputeRate": { "type": "number" },
        "verifiableHash": { "type": "string", "maxLength": 128 },
        "walletAddress": { "type": "string", "maxLength": 128 },
        "paypalMerchantId": { "type": "string", "maxLength": 128 },
        "isDemo": { "type": "boolean" },
        "capabilities": { "type": "array" }
      },
      "required": ["id", "name", "role", "trustState", "trustScore"]
    },
    "contract": {
      "title": "Contract",
      "description": "A machine-verifiable contract forged between buyer and seller agents with acceptance criteria.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "buyerAgentId": { "type": "string", "maxLength": 128 },
        "sellerAgentId": { "type": "string", "maxLength": 128 },
        "verifierAgentId": { "type": "string", "maxLength": 128 },
        "scope": { "type": "string", "maxLength": 4096 },
        "deliverables": { "type": "array" },
        "acceptanceCriteria": { "type": "array" },
        "budgetUsd": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD"] },
        "deadline": { "type": "string", "maxLength": 64 },
        "revisionPolicy": { "type": "string", "maxLength": 512 },
        "sentinelRiskScore": { "type": "number" },
        "sentinelPolicy": { "type": "string", "enum": ["standard", "strict", "zero_trust"] },
        "status": { "type": "string" },
        "contractSha256": { "type": "string", "maxLength": 128 },
        "paypalOrderId": { "type": "string", "maxLength": 128 },
        "paypalPaymentStatus": { "type": "string" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "buyerAgentId", "sellerAgentId", "budgetUsd", "status", "contractSha256"]
    },
    "sentinelAlert": {
      "title": "SentinelAlert",
      "description": "An application-level transaction risk investigation record generated by PayPal Sentinel.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "transactionId": { "type": "string", "maxLength": 128 },
        "contractId": { "type": "string", "maxLength": 128 },
        "agentId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "riskScore": { "type": "number" },
        "severity": { "type": "string", "enum": ["low", "moderate", "high", "critical"] },
        "alertType": { "type": "string" },
        "summary": { "type": "string", "maxLength": 512 },
        "explanation": { "type": "string", "maxLength": 2048 },
        "factors": { "type": "array" },
        "recommendedAction": { "type": "string", "enum": ["authorize", "escalate", "reject"] },
        "decisionStatus": { "type": "string", "enum": ["pending", "authorized", "rejected", "escalated"] }
      },
      "required": ["id", "contractId", "riskScore", "severity", "decisionStatus"]
    },
    "proofRecord": {
      "title": "ProofVerificationRecord",
      "description": "An independent attestation report generated by the Proof Engine verifying contract criteria.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "contractId": { "type": "string", "maxLength": 128 },
        "verifierAgentId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "criteriaResults": { "type": "array" },
        "overallVerdict": { "type": "string", "enum": ["passed", "failed", "needs_review"] },
        "deliverableSha256": { "type": "string", "maxLength": 128 },
        "verifierSignature": { "type": "string", "maxLength": 256 },
        "executionLogs": { "type": "array" }
      },
      "required": ["id", "contractId", "verifierAgentId", "overallVerdict", "deliverableSha256", "verifierSignature"]
    },
    "ledgerEvent": {
      "title": "LedgerEvent",
      "description": "An immutable cryptographic application event block in the NEXUS Trust Ledger.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "blockHeight": { "type": "number" },
        "timestamp": { "type": "string", "maxLength": 64 },
        "eventType": { "type": "string" },
        "contractId": { "type": "string", "maxLength": 128 },
        "actorAgentId": { "type": "string", "maxLength": 128 },
        "payloadHash": { "type": "string", "maxLength": 128 },
        "prevBlockHash": { "type": "string", "maxLength": 128 },
        "blockHash": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "maxLength": 512 }
      },
      "required": ["id", "blockHeight", "eventType", "contractId", "payloadHash", "blockHash"]
    },
    "paypalTransaction": {
      "title": "PayPalTransaction",
      "description": "A PayPal Sandbox escrow order and capture lifecycle record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 128 },
        "contractId": { "type": "string", "maxLength": 128 },
        "buyerEmail": { "type": "string", "maxLength": 128 },
        "sellerMerchantId": { "type": "string", "maxLength": 128 },
        "amountUsd": { "type": "number" },
        "status": { "type": "string", "enum": ["CREATED", "ESCROW_HOLD", "CAPTURED", "REFUNDED", "HELD_FOR_REVIEW"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "sentinelRiskPassed": { "type": "boolean" },
        "proofVerified": { "type": "boolean" },
        "authorizationCode": { "type": "string", "maxLength": 128 },
        "sandboxMode": { "type": "boolean" }
      },
      "required": ["id", "orderId", "contractId", "amountUsd", "status"]
    },
    "processedWebhookEvent": {
      "title": "ProcessedWebhookEvent",
      "description": "An idempotency record tracking received and processed PayPal webhook events to prevent duplicate executions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "eventId": { "type": "string", "maxLength": 128 },
        "eventType": { "type": "string", "maxLength": 128 },
        "resourceId": { "type": "string", "maxLength": 128 },
        "processedAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "eventId", "eventType", "processedAt", "status"]
    }
  },
  "firestore": {
    "/agents/{agentId}": {
      "schema": { "$ref": "#/entities/agent" },
      "description": "Autonomous agents directory and trust ratings."
    },
    "/contracts/{contractId}": {
      "schema": { "$ref": "#/entities/contract" },
      "description": "Autonomous contracts forged between agents."
    },
    "/sentinelAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/sentinelAlert" },
      "description": "PayPal Sentinel transaction risk evaluations and decisions."
    },
    "/proofRecords/{recordId}": {
      "schema": { "$ref": "#/entities/proofRecord" },
      "description": "Independent verification attestations and execution logs."
    },
    "/ledgerEvents/{eventId}": {
      "schema": { "$ref": "#/entities/ledgerEvent" },
      "description": "Hash-chained chronological application event blocks."
    },
    "/paypalTransactions/{transactionId}": {
      "schema": { "$ref": "#/entities/paypalTransaction" },
      "description": "PayPal Sandbox order and capture lifecycle records."
    },
    "/processedWebhookEvents/{eventId}": {
      "schema": { "$ref": "#/entities/processedWebhookEvent" },
      "description": "PayPal webhook idempotency deduplication ledger."
    }
  }
}
