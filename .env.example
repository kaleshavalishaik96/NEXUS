# ==============================================================================
# NEXUS — Trust Fabric for the AI Economy (.env.example)
# ==============================================================================
# In Google AI Studio:
# Set credentials securely via the Secrets panel in the AI Studio UI.
# Secrets are automatically injected into process.env at server runtime.
# Do NOT hardcode credentials into source files or commit secrets to git.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Persistent Database: Firebase Cloud Firestore
# ------------------------------------------------------------------------------
# NEXUS uses Google Cloud Firestore for persistent storage.
# Configuration is managed via firebase-applet-config.json (generated during setup).
# No DATABASE_URL connection string is required.

# ------------------------------------------------------------------------------
# PayPal Sandbox Integration
# ------------------------------------------------------------------------------
# Obtain these from developer.paypal.com -> Dashboard -> Apps & Credentials (Sandbox)
# Required for live PayPal Sandbox checkout, escrow hold, and capture API calls.
PAYPAL_CLIENT_ID="YOUR_PAYPAL_SANDBOX_CLIENT_ID"
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_SANDBOX_CLIENT_SECRET"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"

# PayPal Webhook ID (Optional in Development)
# Generated when registering a webhook URL in developer.paypal.com dashboard.
# If left empty or unconfigured during local development, the backend acknowledges
# webhook payloads but reports signature status as UNVERIFIED without executing
# automated financial settlement.
PAYPAL_WEBHOOK_ID=""

# ------------------------------------------------------------------------------
# Gemini AI API Key (Optional)
# ------------------------------------------------------------------------------
# Automatically injected by Google AI Studio from user secrets when enabled.
# Powers live LLM reasoning for agent task execution & Sentinel threat synthesis.
GEMINI_API_KEY=""
